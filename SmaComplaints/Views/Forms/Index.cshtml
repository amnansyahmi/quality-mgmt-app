@model List<FormSummary>
@{ViewData["Title"]="Form Library";}
<div class="queue-page"><div class="queue-page-heading"><div><h1>Form Library</h1><p>Published forms and their record workspaces.</p></div>@if(User.IsInRole(Roles.Admin)){<a class="btn primary" href="/FormStudio">Import a form</a>}</div><section class="queue-sheet"><header><h2>Available forms <span>@Model.Count</span></h2></header>@if(Model.Count==0){<div class="queue-empty"><h2>No published forms yet</h2><p>An administrator can import a DOCX, PDF or scanned form in Form Studio, review it, and publish it here.</p></div>}else{<div class="draft-list">@foreach(var f in Model){<article><div><h3><a href="/Forms/Module/@f.Id">@f.Name</a></h3><p>@f.FieldCount fields · @f.StepCount workflow tasks</p></div><a class="btn secondary" href="/Forms/Module/@f.Id">Open workspace</a></article>}</div>}</section></div>
