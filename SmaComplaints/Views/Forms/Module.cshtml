@model FormModuleVm
@{var d=Model.Definition;ViewData["Title"]=d.Name;var mine=Model.Entries.Count(e=>FormRuntime.CanAct(e,Model.User));}
<div class="queue-page"><div class="queue-page-heading"><div><h1>@d.Name</h1><p>@d.Fields.Count fields · @d.Steps.Count workflow tasks · @mine tasks assigned to you</p></div>@if(d.SubmitRoles.Contains(Model.User.Role)){<form method="post" action="/Forms/Create">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@d.Id" /><button class="btn primary">New record</button></form>}</div><section class="queue-sheet"><header><h2>Records <span>@Model.Entries.Count</span></h2>@if(Model.Entries.Count==0){<div class="queue-empty"><h2>No accessible records</h2><p>Records appear here when you submit this form or receive an assigned task.</p></div>}else{<div class="queue-table-scroll"><table class="queue-table"><thead><tr><th>Reference</th><th>Status / current task</th><th>Task holder</th><th>Updated</th><th></th></tr></thead><tbody>@foreach(var e in Model.Entries){<tr><td><a class="queue-reference" href="/Forms/Entry/@e.Id">@e.Reference</a></td><td>@e.State<small>@FormRuntime.StepName(e)</small></td><td>@QueueViews.Person(Model.Users,FormRuntime.Assignee(e),e.State=="Completed"?"Complete":"Unassigned")</td><td>@Ui.Date(e.UpdatedAt)</td><td><a class="btn secondary small" href="/Forms/Entry/@e.Id">@(FormRuntime.CanAct(e,Model.User)?"Open task":"View")</a></td></tr>}</tbody></table></div>}</section></div>
