@model FormModuleVm
@{var e=Model.Entry!;var canAct=!Model.Preview&&FormRuntime.CanAct(e,Model.User);}
@foreach(var group in e.Schema.Fields.GroupBy(x=>x.Section)){<section class="runtime-section"><h2>@group.Key</h2><div class="runtime-fields">@foreach(var f in group){var value=e.Values.GetValueOrDefault(f.Key,"");var editable=canAct&&f.Stage==e.Step;var inputName="v_"+f.Key;<div class="runtime-field @(f.Type is "Table" or "Multiline" or "Attachment"?"wide":"")"><label for="@inputName">@f.Label @(f.Required?"*":"")</label><small class="runtime-stage-label">@(f.Stage==0?"Submitter":$"Step {f.Stage+1}: {e.Schema.Steps.ElementAtOrDefault(f.Stage-1)?.Name}")</small><fieldset disabled="@(!editable)">
@if(f.Type=="Table"){var columns=FormRuntime.Columns(f);var rows=e.Tables.GetValueOrDefault(f.Key,[]);var rowCount=editable?Math.Min(20,Math.Max(3,rows.Count+1)):rows.Count;<div class="queue-table-scroll"><table class="runtime-repeat" data-runtime-table="@f.Key" data-row-label="@f.Label"><thead><tr>@foreach(var col in columns){<th>@col.Label</th>}@if(editable){<th class="row-control"><span class="sr-only">Row actions</span></th>}</tr></thead><tbody>@for(var row=0;row<rowCount;row++){<tr>@foreach(var col in columns){<td><input name="t_@(f.Key)_@(row)_@col.Key" value="@(row<rows.Count?rows[row].GetValueOrDefault(col.Key,""):"")" type="@col.Type" step="any" maxlength="4000" aria-label="@f.Label row @(row+1) @col.Label" /></td>}@if(editable){<td class="row-control"><button type="button" class="btn secondary small" data-delete-runtime-row aria-label="Delete @f.Label row @(row+1)">Delete row</button></td>}</tr>}</tbody></table></div>@if(editable){<button type="button" class="btn secondary small" data-add-runtime-row="@f.Key">Add row</button>}}
else if(f.Type=="Attachment"){<div class="runtime-attachments">@foreach(var file in e.Files.Where(x=>x.FieldKey==f.Key)){<a href="/Forms/Download/@e.Id?fileId=@file.Id">@file.Name <small>@((file.Size/1024d).ToString("N1")) KB</small></a>}</div>@if(editable){<input type="file" id="@inputName" name="file_@f.Key" accept=".pdf,.png,.jpg,.jpeg,.docx,.xlsx,.csv,.txt,.zip" multiple /><small>Up to 10 MB per file; 20 files and 50 MB per record.</small>}}
else if(f.Type=="Multiline"){<textarea id="@inputName" name="@inputName" rows="3" maxlength="8000">@value</textarea>}
else if(f.Type is "Choice" or "YesNo"){<select id="@inputName" name="@inputName"><option value="">Choose…</option>@foreach(var option in f.Type=="YesNo"?new[]{"Yes","No","Not applicable"}:FormRuntime.Choices(f)){<option selected="@(option==value)">@option</option>}</select>}
else if(f.Type=="MultiChoice"){@foreach(var option in FormRuntime.Choices(f)){<label class="runtime-choice"><input name="@inputName" type="checkbox" value="@option" checked="@value.Split('|').Contains(option)" />@option</label>}}
else{<input id="@inputName" name="@inputName" value="@value" type="@(f.Type=="Date"?"date":f.Type=="Number"?"number":"text")" step="any" maxlength="8000" />}
</fieldset></div>}</div></section>}
