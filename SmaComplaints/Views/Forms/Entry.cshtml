@model FormModuleVm
@{var e=Model.Entry!;var d=e.Schema;var canAct=!Model.Preview&&FormRuntime.CanAct(e,Model.User);ViewData["Title"]=Model.Preview?d.Name+" · preview":e.Reference;var next=e.Step<d.Steps.Count?d.Steps[e.Step]:null;var lastReturn=e.State=="Returned"?e.History.LastOrDefault(x=>x.Action=="Returned for correction"):null;string Person(Guid? id)=>QueueViews.Person(Model.Users,id);}
<div class="queue-page runtime-page"><div class="queue-page-heading"><div><a class="queue-reference" href="@(Model.Preview?"/FormStudio/Edit/"+d.Id:"/Forms/Module/"+e.DefinitionId)">@d.Name</a><h1>@e.Reference</h1><p>@(Model.Preview?"Saved design preview; fields are not submitted.":e.State+" · "+FormRuntime.StepName(e)+" · "+Person(FormRuntime.Assignee(e)))</p></div><a class="btn secondary" href="@(Model.Preview?"/FormStudio/Edit/"+d.Id:"/Forms/Module/"+e.DefinitionId)">@(Model.Preview?"Back to designer":"All records")</a></div>
<ol class="runtime-route" data-workflow-numbering="1" data-runtime-state="@(Model.Preview?"Preview":e.State)"><li class="@(e.Step==0?"current":"")"><b>1</b> Submitter <span>@Person(e.CreatedBy)</span></li>@for(var i=0;i<d.Steps.Count;i++){<li class="@(e.State!="Completed"&&e.Step==i+1?"current":"")"><b>@(i+2)</b> @d.Steps[i].Name <span>@d.Steps[i].Role</span></li>}<li class="@(e.State=="Completed"?"current":"")">Completed</li></ol>
@if(lastReturn is not null){<div class="workflow-return-message"><strong>Returned by @lastReturn.Actor</strong><p>@lastReturn.Note</p><small>Correct the existing record and send it forward again. The reference is unchanged.</small></div>}
<form id="module-entry-form" method="post" action="/Forms/Save" enctype="multipart/form-data">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.Id" /><input type="hidden" name="revision" value="@e.Revision" /><div class="queue-sheet runtime-sheet">@await Html.PartialAsync("~/Views/Forms/_Fields.cshtml",Model)</div>
@if(canAct){<section class="queue-sheet runtime-task"><h2>@FormRuntime.StepName(e)</h2><p>Only fields assigned to this step can be changed. Progress can be saved before sending to the next task holder.</p><div class="runtime-task-inputs">@if(next is not null){<label for="module-recipient">Send next task to · @next.Role<select id="module-recipient" name="nextAssigneeId"><option value="">Select a person</option>@foreach(var person in Model.Users.Where(x=>x.Active&&x.Role==next.Role)){<option value="@person.Id" selected="@(e.Assignees.GetValueOrDefault(e.Step+1)==person.Id)">@person.Name</option>}</select></label>}<label for="module-note">Decision / handoff note<textarea id="module-note" name="note" rows="2" maxlength="4000"></textarea></label></div><div class="studio-actions"><button class="btn secondary" name="command" value="save">Save progress</button><button class="btn primary" name="command" value="advance">@(next is null?"Complete record":e.Step==0?"Submit to first task":d.Steps[e.Step-1].Kind=="Approval"?"Approve & forward":"Complete task & forward")</button></div></section>}</form>
@if(canAct&&e.Step>0&&FormRuntime.ReturnTargets(e).Length>0){<details class="queue-sheet runtime-return"><summary>Return for correction</summary><form action="/Forms/Save" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.Id" /><input type="hidden" name="revision" value="@e.Revision" /><input type="hidden" name="command" value="return" /><label for="module-return-target">Return to<select id="module-return-target" name="returnTarget" required>@foreach(var target in FormRuntime.ReturnTargets(e)){<option value="@target">@(target==0?"Step 1: Submitter · "+Person(e.CreatedBy):$"Step {target+1}: {d.Steps[target-1].Name} · {Person(e.Assignees.GetValueOrDefault(target))}")</option>}</select></label><label for="module-return-note">What needs correcting?<textarea id="module-return-note" name="note" required rows="3" maxlength="4000"></textarea></label><button class="btn secondary">Return record</button></form></details>}
@if(!Model.Preview){<section class="queue-sheet runtime-history"><h2>Record history</h2>@foreach(var h in e.History.OrderByDescending(x=>x.At)){<article><strong>@h.Action</strong><span>@h.Actor · @Ui.Date(h.At) · step @(h.From+1) → @(h.To+1)</span>@if(h.Note!=""){<p>@h.Note</p>}</article>}</section>}</div>
@section Scripts{<script src="~/js/form-studio.js" asp-append-version="true"></script>}
