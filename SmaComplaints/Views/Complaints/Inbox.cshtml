@model DashboardVm
@inject Workflow Flow
@{ViewData["Title"]="My task inbox";var ids=QueueViews.Filter(Model,Model.Complaints).Select(c=>c.Id).ToHashSet();var tasks=Model.Tasks.Where(t=>ids.Contains(t.Complaint.Id)).ToList();string Person(Guid? id)=>QueueViews.Person(Model.Users,id);}
<div class="queue-page" data-screen="inbox"><div class="queue-page-heading"><div><h1>My task inbox</h1><p>@Model.User.Name · tasks that need your action as @Model.User.Role.</p></div><a class="btn secondary" href="/Complaints?view=register">Browse register</a></div><div class="queue-inline-totals"><span><b>@(tasks.Count+Model.FormTasks.Count)</b> tasks</span><span><b>@(tasks.Count(t=>t.Kind=="approval")+Model.FormTasks.Count(e=>e.Step>0&&e.Schema.Steps[e.Step-1].Kind=="Approval"))</b> approvals</span><span><b>@(tasks.Count(t=>Workflow.LatestReturn(t.Complaint) is not null)+Model.FormTasks.Count(e=>e.State=="Returned"))</b> returned for correction</span></div><form class="queue-toolbar" method="get" action="/Complaints"><input type="hidden" name="view" value="inbox" /><label class="queue-search"><span class="sr-only">Search my tasks</span><input name="q" value="@Model.Query" placeholder="Search complaint or form tasks" /></label><button class="btn secondary small">Search tasks</button>@if(!string.IsNullOrWhiteSpace(Model.Query)){<a href="/Complaints?view=inbox" class="btn secondary small">Clear search</a>}</form>
@if(tasks.Count==0&&Model.FormTasks.Count==0){<section class="queue-empty queue-sheet"><h2>Your inbox is clear</h2><p>Tasks appear here when a complaint reaches your assigned stage. Records being handled by someone else remain in the register.</p><a class="btn secondary" href="/Complaints?view=register">View complaint register</a></section>}
@foreach(var group in new[]{("Decisions",tasks.Where(t=>t.Kind!="form").ToList()),("Preparation & corrections",tasks.Where(t=>t.Kind=="form").ToList())}.Where(g=>g.Item2.Count>0)){<section class="queue-sheet inbox-section"><header><h2>@group.Item1 <span>@group.Item2.Count</span></h2></header><div class="inbox-task-list">@foreach(var task in group.Item2){var c=task.Complaint;var next=Workflow.NextStage(c.Stage);var returned=Workflow.LatestReturn(c);var anchor=task.Kind is "extension" or "delay"?"decision-"+task.Kind:task.Kind=="approval"?"workflow-task":"complaint-form";<article class="inbox-task"><div class="inbox-task-main"><a class="queue-reference" href="/Complaints/Details/@c.Id?tab=@task.Tab&amp;from=inbox#@anchor">@c.Reference</a><h3>@task.Title</h3><p>@(c.Subject==""?"Untitled complaint":c.Subject)</p>@if(returned is not null){<details class="inbox-return-note"><summary>Returned by @returned.ActorName · view reason</summary><p>@returned.Note</p></details>}@if(task.Waiting){<span class="queue-waiting">Waiting for the owner to save the evaluation and reporting answers.</span>}</div><div class="inbox-task-route"><span>@(task.Kind=="approval"?"After approval":"Current stage")</span><strong>@(task.Kind=="approval" && next.HasValue?(next==Stage.Closed?"Complaint closed":Person(Workflow.AssigneeAt(c,next.Value))):Ui.StageName(c.Stage))</strong><small>@(task.Kind=="approval" && next.HasValue?Ui.TaskRole(next.Value):QueueViews.Deadline(c))</small></div><a class="btn @(task.Waiting?"secondary":"primary") small" href="/Complaints/Details/@c.Id?tab=@task.Tab&amp;from=inbox#@anchor">@task.ActionLabel</a></article>}</div></section>}

@if(Model.FormTasks.Count>0){<section class="queue-sheet"><header><h2>Form Library tasks <span>@Model.FormTasks.Count</span></h2></header><div class="inbox-task-list">@foreach(var entry in Model.FormTasks){<article class="inbox-task"><div class="inbox-task-main"><a class="queue-reference" href="/Forms/Entry/@entry.Id">@entry.Reference</a><h3>@entry.Schema.Name</h3><p>@FormRuntime.StepName(entry) · @entry.State</p></div><div class="inbox-task-route"><span>Last updated</span><strong>@Ui.Date(entry.UpdatedAt)</strong></div><a class="btn primary small" href="/Forms/Entry/@entry.Id">Open form task</a></article>}</div></section>}
</div>
