@model DashboardVm
<form method="get" action="/Complaints" class="queue-toolbar"><input type="hidden" name="view" value="@Model.View" /><label class="queue-search"><span class="sr-only">Search complaints</span><input name="q" value="@Model.Query" placeholder="Reference, subject, customer or laboratory" /></label><label><span class="sr-only">Filter by workflow stage</span><select name="status"><option value="">All stages</option>@foreach(var stage in Enum.GetValues<Stage>()){<option value="@stage" selected="@(Model.Status==stage.ToString())">@Ui.StageName(stage)</option>}</select></label><button class="btn secondary small">Apply filters</button>@if(Model.Query!=""||Model.Status!=""){<a class="text-button" href="/Complaints?view=@Model.View">Clear filters</a>}</form>
