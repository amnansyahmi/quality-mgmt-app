@model DetailVm
@inject Workflow Flow
@{var c=Model.Complaint;var u=Model.User;var editable=Flow.CanEditB(c,u);var completion=c.Stage>=Stage.Actions;}
<div class="section-heading"><span class="section-number">B</span><div><h2>Complaint processing</h2><p>Evaluation, investigation, action planning, and verified completion.</p></div></div>
@if(c.Stage==Stage.Evaluation&&Flow.IsAssigned(c,u))
{
<section class="assignment-section"><h3>Assign the responsible people</h3><p class="muted">The assigned QM owns evaluation, reporting review, effectiveness monitoring, and closure review.</p><form method="post" action="/Complaints/Assign">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="revision" value="@c.Revision" /><div class="field-grid"><div class="field"><label for="department">Responsible department</label><input id="department" name="department" value="@c.Department" required maxlength="150" /></div>@foreach(var assignment in new[]{("ownerId","Complaint owner",Roles.Owner,c.OwnerId),("hodId","HOD approver",Roles.Hod,c.HodId),("qmId","Quality Manager",Roles.Qm,c.QmId),("cmId","CM approver",Roles.Cm,c.CmId)}){<div class="field"><label for="@assignment.Item1">@assignment.Item2</label><select id="@assignment.Item1" name="@assignment.Item1" required><option value="">Select a person…</option>@foreach(var person in Model.Users.Where(x=>x.Active&&x.Role==assignment.Item3)){<option value="@person.Id" selected="@(person.Id==assignment.Item4)">@person.Name</option>}</select></div>}</div><button class="btn primary">Assign & begin investigation<icon name="arrow-right" size="16" /></button></form><details class="request-details"><summary>Return notification for correction</summary><form method="post" action="/Complaints/ReturnToRequestor">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="revision" value="@c.Revision" /><div class="field"><label for="return-note">Reason</label><textarea name="note" id="return-note" required></textarea></div><button class="btn secondary">Return to requestor</button></form></details></section>
}
<form action="/Complaints/Edit" method="post" data-dirty-form><input type="hidden" name="returnToInbox" value="true" />@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="revision" value="@c.Revision" /><input type="hidden" name="section" value="processing" />
<fieldset disabled="@(!editable||completion)"><div class="field-grid">@await Html.PartialAsync("_Field",new FieldVm("ReceivedDate","Complaint received date",c.ReceivedDate?.ToString("yyyy-MM-dd"),"date")) @await Html.PartialAsync("_Field",new FieldVm("ReceivedBy","Complaint received by",c.ReceivedBy)) @await Html.PartialAsync("_Field",new FieldVm("ReceivedVia","Received via",c.ReceivedVia,Options:["Telephone","Email / letter","Fax","Verbal","Website"]))</div>
<h3 class="section-subtitle">2.1 Complaint evaluation</h3><div class="field-grid">@await Html.PartialAsync("_Field",new FieldVm("Category","Complaint category",c.Category,Options:["Quality","Non-Quality"],Required:true)) @await Html.PartialAsync("_Field",new FieldVm("Seriousness","Seriousness",c.Seriousness,Options:["Not Critical","Critical","Very Critical","Not Applicable"])) @await Html.PartialAsync("_Field",new FieldVm("Hazard","Hazard",c.Hazard,Options:["Not Hazardous / Low","Medium","High","Not Applicable"])) @await Html.PartialAsync("_Field",new FieldVm("Urgency","Urgency",c.Urgency,Options:["Within 24 hours","Within 1 week","Within 1 month","Not Applicable"]))</div><p class="form-hint">Non-quality complaints use Not Applicable for seriousness, hazard, urgency, and reporting criteria. Urgency deadlines run from the complaint record creation time.</p>
<h4>Reportable criteria for quality complaints</h4><p class="muted small-text">The source form requires reporting when any criterion is Yes. QM confirms the determination and reporting due date.</p>
@foreach(var question in new[]{("HealthHazard","There is a health hazard associated with the medical device.",c.HealthHazard),("ManufacturerClaim","The device fails a manufacturer claim relating to safety, quality, or performance.",c.ManufacturerClaim),("LegislativeRequirement","The medical device fails to meet a legislative requirement.",c.LegislativeRequirement),("IntendedPurpose","The device, labelling, or packaging fails to achieve the intended purpose.",c.IntendedPurpose)}){<div class="report-question"><label for="q-@question.Item1">@question.Item2</label><select id="q-@question.Item1" name="@question.Item1"><option value="">Not answered / N.A.</option><option value="true" selected="@(question.Item3==true)">Yes</option><option value="false" selected="@(question.Item3==false)">No</option></select></div>}
<h3 class="section-subtitle">2.2 Investigation</h3>@await Html.PartialAsync("_Field",new FieldVm("RootCause","Root cause after investigation",c.RootCause,"textarea",Required:true))<div class="field-grid">@await Html.PartialAsync("_Field",new FieldVm("Investigator","Investigated by",c.Investigator)) @await Html.PartialAsync("_Field",new FieldVm("InvestigationDate","Investigation completed date",c.InvestigationDate?.ToString("yyyy-MM-dd"),"date"))</div></fieldset>
<h3 class="section-subtitle">@(completion?"2.5 Completion of actions":"2.3 Action plan")</h3><fieldset disabled="@(!editable)">@await Html.PartialAsync("_Actions",("Actions",c.Actions,completion,editable,completion))</fieldset>
@if(editable){<div class="form-footer"><span>@(completion?"The approved action plan is locked. Add completion dates and evidence.":"Save the evaluation so QM can review reportability.")</span><button class="btn secondary" name="command" value="save">Save progress</button><button class="btn primary" name="command" value="advance">@Workflow.SubmitLabel(c)<icon name="arrow-right" size="16" /></button></div>}</form>
@if(c.Stage==Stage.Investigation&&u.Role==Roles.Qm&&c.QmId==u.Id)
{
<section class="subsection"><h3>QM reporting review</h3><p class="muted">Review the owner's saved evaluation. A later change to the category or reporting criteria requires another QM review.</p><form action="/Complaints/Reporting" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="revision" value="@c.Revision" /><div class="field-grid"><div class="field"><label for="reportable">Reportable incident?</label><select id="reportable" name="reportable"><option value="">Not applicable</option><option value="true" selected="@(c.Reportable==true)">Yes</option><option value="false" selected="@(c.Reportable==false)">No</option></select></div><div class="field"><label for="reporting-due">Reporting due date</label><input type="date" id="reporting-due" name="reportingDueDate" value="@c.ReportingDueDate?.ToString("yyyy-MM-dd")" /></div></div><div class="field"><label for="reporting-note">Basis for decision</label><textarea name="reportingNote" id="reporting-note" required>@c.ReportingNote</textarea></div><button class="btn primary">Confirm reporting review</button></form></section>
}
<h3 class="section-subtitle">2.4 and 2.6 Approvals</h3>@await Html.PartialAsync("_ApprovalHistory",c)
<h3 class="section-subtitle">2.7 Response exceeding one week and 2.8 Extension</h3>
@if(c.ResponseDelayPending||c.ExtensionPending){<p class="read-only-note">An exception request is awaiting HOD approval.</p>}
@if(c.ResponseDelayReason!=""){<p><b>Response delay reason:</b> @c.ResponseDelayReason <span class="badge draft">@(c.ResponseDelayPending?"Pending HOD":c.ResponseDelayApproved?"Approved":"Not approved")</span></p>}
@if(c.ExtensionReason!=""){<p><b>Extension reason:</b> @c.ExtensionReason <span class="muted">Requested deadline @c.RequestedDueDate?.ToString("dd MMM yyyy")</span></p>}
@if(c.OwnerId==u.Id&&u.Role==Roles.Owner&&c.Stage is Stage.Investigation or Stage.Actions)
{
<details class="request-details"><summary>Request delay approval or an extension</summary><form action="/Complaints/RequestException" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="revision" value="@c.Revision" /><div class="field-grid"><div class="field"><label for="request-kind">Request type</label><select name="kind" id="request-kind"><option value="extension">Extend the action deadline</option><option value="delay">Response requires more than one week</option></select></div><div class="field"><label for="requested-date">Requested deadline for extension</label><input type="date" name="requestedDate" id="requested-date" /></div></div><div class="field"><label for="request-reason">Reason</label><textarea name="reason" id="request-reason" required></textarea></div><button class="btn secondary">Send to HOD</button></form></details>
}
@if(c.HodId==u.Id&&u.Role==Roles.Hod)
{
@foreach(var kind in new[]{"delay","extension"}.Where(x=>x=="delay"?c.ResponseDelayPending:c.ExtensionPending))
{<form action="/Complaints/DecideException" method="post" class="subsection">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="revision" value="@c.Revision" /><input type="hidden" name="kind" value="@kind" /><h4>HOD decision · @kind</h4><div class="field"><label for="decision-@kind">Decision reason</label><textarea id="decision-@kind" name="note" required></textarea></div><button class="btn primary" name="approve" value="true">Approve request</button><button class="btn secondary" name="approve" value="false">Decline request</button></form>}
}
