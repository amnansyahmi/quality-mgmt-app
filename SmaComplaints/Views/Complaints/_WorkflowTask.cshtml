@model DetailVm
@inject Workflow Flow
@{
    var c=Model.Complaint;var u=Model.User;var assigned=Flow.IsAssigned(c,u);var approval=Workflow.IsApprovalStage(c.Stage);var next=Workflow.NextStage(c.Stage);var returned=Workflow.LatestReturn(c);
    string Person(Guid? id)=>QueueViews.Person(Model.Users,id,"Not assigned");
    var taskHolder=c.Stage==Stage.Evaluation && c.QmId is null?"QM queue":Person(Flow.Assignee(c));
    var nextPeople=next.HasValue?Model.Users.Where(p=>p.Active&&p.Role==Ui.TaskRole(next.Value)).OrderBy(p=>p.Name).ToList():new List<AppUser>();
    Stage[] route=c.Stage switch{Stage.Draft or Stage.Evaluation=>[Stage.Draft,Stage.Evaluation,Stage.Investigation],Stage.Investigation or Stage.PlanHod or Stage.PlanQm=>[Stage.Investigation,Stage.PlanHod,Stage.PlanQm],Stage.Actions or Stage.CompletionHod or Stage.CompletionQm=>[Stage.Actions,Stage.CompletionHod,Stage.CompletionQm],_=>[Stage.Effectiveness,Stage.ClosureQm,Stage.ClosureCm,Stage.Closed]};
    var position=Array.IndexOf(route,c.Stage);
}
<section class="workflow-handoff" id="workflow-task" aria-labelledby="current-task-heading"><div class="workflow-route-summary"><div class="workflow-task-heading"><h2 id="current-task-heading">@Ui.StageName(c.Stage)</h2><span>@(c.Stage==Stage.Closed?"Complete":assigned?"Your task":"With "+taskHolder)</span></div>
<ol class="workflow-route" aria-label="Current approval sequence">@for(var i=0;i<route.Length;i++){var step=route[i];<li class="@(step==c.Stage?"current":i<position?"done":"")" aria-current="@(step==c.Stage?"step":null)"><span class="route-step-name">@Ui.StageName(step)</span><strong>@(step==Stage.Closed?"Record closed":Person(Workflow.AssigneeAt(c,step)))</strong><small>@(step==c.Stage?"Current task":i<position?"Previous step":Ui.TaskRole(step))</small></li>}</ol>

@if(returned is not null){<div class="workflow-return-message" role="status"><strong>Returned by @returned.ActorName for correction</strong><p>@returned.Note</p><small>Update the existing complaint and resubmit. The reference remains @c.Reference.</small></div>}
@if(!assigned&&c.Stage!=Stage.Closed){<p class="workflow-readonly">The current task holder makes this decision. You can review the form, evidence, and history below.</p>}
<div class="workflow-review-links"><a href="/Complaints/Details/@c.Id?tab=processing#complaint-form">Review processing</a><a href="/Complaints/Details/@c.Id?tab=evidence#complaint-form">Evidence (@c.Attachments.Count)</a><a href="/Complaints/Details/@c.Id?tab=history#complaint-form">Decision history</a></div></div>
<div class="workflow-decision">
@if(assigned&&approval){<form action="/Complaints/Task" method="post" class="workflow-forward-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="revision" value="@c.Revision" /><input type="hidden" name="command" value="advance" /><input type="hidden" name="returnToInbox" value="true" />
@if(next!=Stage.Closed&&next.HasValue){<label for="next-assignee">Send next task to · @Ui.TaskRole(next.Value)</label><select id="next-assignee" name="nextAssigneeId" required><option value="">Select next task holder</option>@foreach(var person in nextPeople){<option value="@person.Id" selected="@(person.Id==Workflow.AssigneeAt(c,next.Value))">@person.Name · @person.Department</option>}</select>@if(nextPeople.Count==0){<p class="queue-danger">An active @Ui.TaskRole(next.Value) account is required. Ask an administrator to activate or create one.</p>}}
<label for="forward-note">Decision note <span>(optional)</span></label><textarea id="forward-note" name="note" rows="2" maxlength="4000" placeholder="Record your approval comments"></textarea><button class="btn primary full" disabled="@(next!=Stage.Closed&&nextPeople.Count==0)">@(next==Stage.Closed?"Approve & close complaint":"Approve & forward")</button></form>
<details class="workflow-return-control"><summary>Return for correction</summary><form action="/Complaints/Task" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="revision" value="@c.Revision" /><input type="hidden" name="command" value="return" /><input type="hidden" name="returnToInbox" value="true" /><label for="return-stage">Return task to</label><select id="return-stage" name="returnStage" required>@foreach(var destination in Workflow.ReturnTargets(c.Stage)){<option value="@destination">@Person(Workflow.AssigneeAt(c,destination)) · @Ui.StageName(destination)</option>}</select><label for="return-reason">What needs correcting?</label><textarea id="return-reason" name="note" rows="3" maxlength="4000" required placeholder="Tell the recipient exactly what to correct"></textarea><p>The same record and its history will be kept.</p><button class="btn secondary full">Send back for correction</button></form></details>}
else if(c.Stage==Stage.Closed){<h3>Complaint closed</h3><p>Final approval is recorded in the decision history.</p><a class="btn secondary" href="/Complaints/Print/@c.Id" target="_blank">Print approved report</a>}
else if(assigned){<h3>@(returned is null?"Continue your task":"Make the requested corrections")</h3><p>@(c.Stage==Stage.Evaluation?"Assign the people responsible for the investigation and subsequent approvals.":"Complete the form and evidence, then submit it to the next workflow stage.")</p><a class="btn primary" href="/Complaints/Details/@c.Id?tab=@(c.Stage==Stage.Draft?"notification":c.Stage==Stage.Effectiveness?"effectiveness":"processing")#complaint-form">@(returned is null?"Open assigned form":"Correct & resubmit")</a>}
else{<h3>Waiting for @taskHolder</h3><p>The task will appear in your inbox when your stage is reached.</p><a class="btn secondary" href="/Complaints?view=inbox">Back to my task inbox</a>}
</div></section>
