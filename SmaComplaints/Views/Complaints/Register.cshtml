@model DashboardVm
@{ViewData["Title"]="Complaint register";var rows=QueueViews.Filter(Model,Model.Complaints).OrderByDescending(c=>c.UpdatedAt).ToList();}
<div class="queue-page" data-screen="register"><div class="queue-page-heading"><div><h1>Complaint register</h1><p>Find a complaint, check its ownership, and review its complete record.</p></div><a class="btn secondary" href="/Complaints/Export">Export register</a></div><div class="queue-inline-totals"><a href="/Complaints?view=overdue">Due &amp; overdue</a><span><b>@Model.Complaints.Count</b> accessible records</span><span><b>@Model.Complaints.Count(c=>c.Stage is not(Stage.Draft or Stage.Closed))</b> open</span><a href="/Complaints?view=register&amp;status=Closed"><b>@Model.Complaints.Count(c=>c.Stage==Stage.Closed)</b> closed</a></div>@await Html.PartialAsync("_QueueToolbar",Model)<section class="queue-sheet"><header><h2>All accessible complaints <span>@rows.Count</span></h2></header>@if(rows.Count>0){@await Html.PartialAsync("_ComplaintRows",new ComplaintListVm(rows,Model))}else{<div class="queue-empty"><h2>No matching complaints</h2><p>Change the search or workflow-stage filter.</p></div>}<footer>@rows.Count matching records · access is restricted by your role and assignments</footer></section></div>
