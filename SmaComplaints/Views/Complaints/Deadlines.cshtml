@model DashboardVm
@{ViewData["Title"]="Due & overdue";var now=DateTimeOffset.UtcNow;var open=QueueViews.Filter(Model,Model.Complaints.Where(c=>c.Stage is not(Stage.Draft or Stage.Closed)&&c.DueAt.HasValue));var late=open.Where(c=>c.DueAt<now).OrderBy(c=>c.DueAt).ToList();var soon=open.Where(c=>c.DueAt>=now&&c.DueAt<=now.AddDays(3)).OrderBy(c=>c.DueAt).ToList();}
<div class="queue-page" data-screen="deadlines"><div class="queue-page-heading"><div><h1>Due & overdue</h1><p>Prioritise missed deadlines and work due within the next three days.</p></div><a class="btn secondary" href="/Complaints?view=inbox">My task inbox</a></div><div class="queue-inline-totals"><span class="queue-danger"><b>@late.Count</b> overdue</span><span><b>@soon.Count</b> due within 3 days</span><span>All dates in Malaysia time</span></div>@await Html.PartialAsync("_QueueToolbar",Model)@foreach(var bucket in new[]{("Overdue",late),("Due within 3 days",soon)}){<section class="queue-sheet deadline-section"><header><h2>@bucket.Item1 <span>@bucket.Item2.Count</span></h2></header>@if(bucket.Item2.Count>0){@await Html.PartialAsync("_ComplaintRows",new ComplaintListVm(bucket.Item2,Model,true))}else{<div class="queue-empty compact"><p>No matching complaints in this deadline group.</p></div>}</section>}</div>
