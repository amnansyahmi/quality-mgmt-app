@model DetailVm
@inject Workflow Flow
@{var c=Model.Complaint;var editable=Flow.CanEditA(c,Model.User);}
<div class="section-heading"><span class="section-number">A</span><div><h2>Complaint notification</h2><p>Record the customer details, product information, and immediate response.</p></div></div>
@if(!editable){<p class="read-only-note">This section is read only at the current stage.</p>}
<form action="/Complaints/Edit" method="post" data-dirty-form><input type="hidden" name="returnToInbox" value="true" />@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="revision" value="@c.Revision" /><input type="hidden" name="section" value="notification" /><fieldset disabled="@(!editable)">
<div class="field-grid"><div class="field"><label for="submitted-by">Submitted by</label><input id="submitted-by" value="@c.SubmittedBy" readonly /><small>Recorded from the signed-in account.</small></div> @await Html.PartialAsync("_Field",new FieldVm("ComplaintDate","Date of complaint",c.ComplaintDate.ToString("yyyy-MM-dd"),"date",Required:true))</div>
<h3 class="section-subtitle">1.1 Customer details <span>Compulsory</span></h3><div class="field-grid">@await Html.PartialAsync("_Field",new FieldVm("CustomerName","Customer name",c.CustomerName,Required:true)) @await Html.PartialAsync("_Field",new FieldVm("Hospital","Hospital / laboratory",c.Hospital,Required:true)) @await Html.PartialAsync("_Field",new FieldVm("Contact","Customer contact number",c.Contact,Required:true)) @await Html.PartialAsync("_Field",new FieldVm("Invoice","Invoice / PO number",c.Invoice,Help:"Not required for an out-of-stock case."))</div><label class="check-option"><input type="checkbox" name="OutOfStock" value="true" checked="@c.OutOfStock" /> Out-of-stock complaint</label>
<h3 class="section-subtitle">1.2 Complaint details</h3>@await Html.PartialAsync("_Field",new FieldVm("Subject","Subject of complaint",c.Subject,Required:true))
<div class="field-grid">@await Html.PartialAsync("_Field",new FieldVm("PartDescription","Part description",c.PartDescription)) @await Html.PartialAsync("_Field",new FieldVm("ProductCode","Product code",c.ProductCode)) @await Html.PartialAsync("_Field",new FieldVm("ProductCategory","Product category",c.ProductCategory,Options:["Instrument","Reagent","QC","Calibrator","Consumable","Other"])) @await Html.PartialAsync("_Field",new FieldVm("SerialLot","Instrument serial / lot number",c.SerialLot)) @await Html.PartialAsync("_Field",new FieldVm("ExpiryDate","Expiry date",c.ExpiryDate?.ToString("yyyy-MM-dd"),"date",Help:"Required for reagent, QC, and calibrator complaints.")) @await Html.PartialAsync("_Field",new FieldVm("Frequency","Frequency",c.Frequency,Options:["Single case","Occasionally","Constantly","Unknown"]))</div>
@await Html.PartialAsync("_Field",new FieldVm("Problem","Detailed problem description",c.Problem,"textarea",Required:true))
<h3 class="section-subtitle">1.3 Immediate correction</h3><div class="checkbox-grid">@foreach(var correction in new[]{"Prepare product retrieval documentation","Return incorrectly shipped products","Dispose of incorrectly shipped products","Arrange delivery","Process replacement","Reprocess correct order","Other","None"}){<label class="check-option"><input type="checkbox" name="Corrections" value="@correction" checked="@c.Corrections.Contains(correction)" />@correction</label>}</div>@await Html.PartialAsync("_Field",new FieldVm("CorrectionOther","Other correction details",c.CorrectionOther))
<h3 class="section-subtitle">1.4 Evidence for immediate correction</h3>@await Html.PartialAsync("_Actions",("ImmediateActions",c.ImmediateActions,true,editable,false))
</fieldset>@if(editable){<div class="form-footer"><span>Save your progress before uploading evidence.</span><button class="btn secondary" name="command" value="save">Save draft</button><button class="btn primary" name="command" value="advance">@Workflow.SubmitLabel(c) →</button></div>}</form><p class="form-hint">Attach supporting photos or data files in the <a href="/Complaints/Details/@c.Id?tab=evidence">Evidence tab</a> before submission.</p>
