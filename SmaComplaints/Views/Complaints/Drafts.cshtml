@model DashboardVm
@{ViewData["Title"]="Drafts & resubmissions";var rows=QueueViews.Filter(Model,Model.Complaints.Where(c=>c.Stage==Stage.Draft&&c.CreatedBy==Model.User.Id)).OrderByDescending(c=>c.UpdatedAt).ToList();}
<div class="queue-page" data-screen="drafts"><div class="queue-page-heading"><div><h1>Drafts & resubmissions</h1><p>Your saved notifications and complaints returned to you for correction.</p></div>@if(Model.User.Role==Roles.Requestor){<form method="post" action="/Complaints/Create">@Html.AntiForgeryToken()<button class="btn primary">New complaint</button></form>}</div><div class="queue-inline-totals"><span><b>@rows.Count</b> editable notifications</span><span><b>@rows.Count(c=>Workflow.LatestReturn(c) is not null)</b> returned for correction</span><span>Private until submitted</span></div><form class="queue-toolbar" method="get" action="/Complaints"><input type="hidden" name="view" value="drafts" /><label class="queue-search"><span class="sr-only">Search drafts</span><input name="q" value="@Model.Query" placeholder="Search your draft notifications" /></label><button class="btn secondary small">Search drafts</button></form><section class="queue-sheet"><header><h2>Continue a notification <span>@rows.Count</span></h2></header>@if(rows.Count==0){<div class="queue-empty"><h2>No draft notifications</h2><p>Only notifications you created appear here. Submitted complaints are available in the register; assigned investigations and reviews are in your task inbox.</p><a class="btn secondary" href="/Complaints?view=inbox">Go to my task inbox</a></div>}else{<div class="draft-list">@foreach(var c in rows){var returned=Workflow.LatestReturn(c);<article><div><a class="queue-reference" href="/Complaints/Details/@c.Id?tab=notification">@c.Reference</a><h3>@(c.Subject==""?"Untitled complaint":c.Subject)</h3><p>@(c.CustomerName==""?"Customer details not entered":c.CustomerName) · updated @Ui.Date(c.UpdatedAt)</p>@if(returned is not null){<div class="draft-return"><strong>Returned by @returned.ActorName</strong><p>@returned.Note</p></div>}</div><a class="btn primary small" href="/Complaints/Details/@c.Id?tab=notification">@(returned is null?"Continue draft":"Correct & resubmit")</a></article>}</div>}</section></div>
