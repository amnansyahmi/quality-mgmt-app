@inject IConfiguration Config
@{ViewData["Title"]="New complaint";var canCreate=User.IsInRole(Roles.Requestor);}
<div class="queue-page"><div class="queue-page-heading"><div><h1>New complaint</h1><p>Start with the customer, product and problem details in Part A.</p></div></div><section class="queue-sheet studio-import"><h2>@(canCreate?"Create a complaint notification":"Use a Requestor account to create a complaint")</h2><p>@(canCreate?"A reference is created when you start. You can save a draft, upload evidence and submit it for QM evaluation.":"Your current role handles investigation, review or administration. Complaint creation is currently restricted to Requestor accounts.")</p>@if(canCreate){<form method="post" action="/Complaints/Create">@Html.AntiForgeryToken()<button class="btn primary">Start new complaint</button></form>}else if(Config.GetValue<bool>("DemoMode")){<form method="post" action="/Account/Demo">@Html.AntiForgeryToken()<input type="hidden" name="role" value="Requestor" /><button class="btn primary">Switch preview to Requestor</button></form><p class="studio-help">Then select New complaint again to start the notification. Preview roles are available only in the development demo.</p>}<p><a class="text-link" href="/Complaints?view=drafts">Continue an existing draft</a> · <a class="text-link" href="/Forms">Use another published form</a></p></section></div>
