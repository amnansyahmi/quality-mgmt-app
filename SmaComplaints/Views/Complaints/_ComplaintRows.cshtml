@model ComplaintListVm
@inject Workflow Flow
<div class="queue-table-scroll" tabindex="0" aria-label="Complaint records"><table class="queue-table"><caption class="sr-only">@Model.Page.View complaint records</caption><thead><tr><th>Complaint</th><th>Customer / laboratory</th><th>Workflow stage</th><th>Current task holder</th><th>@(Model.ShowDeadline?"Deadline / urgency":"Last update")</th><th><span class="sr-only">Open record</span></th></tr></thead><tbody>@foreach(var c in Model.Rows.Take(500)){var returned=Workflow.LatestReturn(c);<tr><td><a class="queue-reference" href="/Complaints/Details/@c.Id">@c.Reference</a><strong class="queue-subject">@(c.Subject==""?"Untitled complaint":c.Subject)</strong>@if(returned is not null){<span class="queue-returned">Returned for correction</span>}</td><td>@(c.CustomerName==""?"Not entered":c.CustomerName)<small>@c.Hospital</small></td><td>@Ui.StageName(c.Stage)</td><td>@QueueViews.Person(Model.Page.Users,Flow.Assignee(c),c.Stage==Stage.Evaluation?"QM queue":"Unassigned")<small>@Ui.TaskRole(c.Stage)</small></td><td>@if(Model.ShowDeadline){<span class="@(Workflow.IsOverdue(c)?"queue-danger":"")">@QueueViews.Deadline(c)</span><small>@Ui.Date(c.DueAt)</small>}else{<span>@Ui.Date(c.UpdatedAt)</span>}</td><td><a class="btn secondary small" href="/Complaints/Details/@c.Id?tab=@(c.Stage==Stage.Draft?"notification":c.Stage is Stage.Effectiveness or Stage.ClosureQm or Stage.ClosureCm?"effectiveness":"processing")">Open</a></td></tr>}</tbody></table></div>
