@model Complaint
@{var decisions=Model.History.Where(x=>x.Action.Contains("Approve",StringComparison.OrdinalIgnoreCase)||x.Action.Contains("Confirm",StringComparison.OrdinalIgnoreCase)||x.Action.Contains("Return",StringComparison.OrdinalIgnoreCase)||x.Action.Contains("declined",StringComparison.OrdinalIgnoreCase)).ToList();}
@if(decisions.Count==0){<p class="muted small-text">No approval decisions recorded yet.</p>}
else{<div class="approval-list">@foreach(var decision in decisions){<div><span class="decision-word @(decision.Action.Contains("Return",StringComparison.OrdinalIgnoreCase)?"returned":"")">@(decision.Action.Contains("Return",StringComparison.OrdinalIgnoreCase)?"Returned":decision.Action.Contains("declined",StringComparison.OrdinalIgnoreCase)?"Declined":"Reviewed")</span><div><strong>@decision.Action</strong><p>@decision.ActorName · @decision.ActorRole <small>@Ui.Date(decision.At)</small></p>@if(decision.Note!=""){<p>@decision.Note</p>}</div></div>}</div>}
