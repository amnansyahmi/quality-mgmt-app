@model DetailVm
@{Layout=null;var c=Model.Complaint;string Person(Guid? id)=>Model.Users.FirstOrDefault(x=>x.Id==id)?.Name??"Unassigned";}
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>@c.Reference · Complaint handling report</title><link href="/css/app.css" rel="stylesheet" /><link href="/css/ui.css" rel="stylesheet" /></head><body class="print-report"><div class="print-toolbar"><a class="back-link" href="/Complaints/Details/@c.Id"><icon name="back" size="16" /><span>Back to complaint</span></a><button class="btn primary" data-print>Print / save as PDF</button></div><header class="print-heading"><div><span class="eyebrow">SMA QUALITY MANAGEMENT</span><h1>Complaint Handling Report</h1></div><div><b>@c.Reference</b><p>Version @c.Revision<br />@Ui.StageName(c.Stage)</p></div></header><p>SMA-FM-QM-05 Rev 07 · 12 September 2025 · Digital record</p>
<h2>Part A Complaint Notification</h2><dl class="report-dl">@foreach(var pair in new[]{("Submitted by",c.SubmittedBy),("Date of complaint",c.ComplaintDate.ToString("dd MMM yyyy")),("Customer",c.CustomerName),("Hospital / laboratory",c.Hospital),("Contact",c.Contact),("Invoice / PO",c.OutOfStock?"Out of stock · not applicable":c.Invoice),("Subject",c.Subject),("Part description",c.PartDescription),("Product code",c.ProductCode),("Category",c.ProductCategory),("Serial / lot",c.SerialLot),("Expiry date",c.ExpiryDate?.ToString("dd MMM yyyy")??""),("Frequency",c.Frequency),("Problem description",c.Problem),("Immediate corrections",string.Join(", ",c.Corrections)),("Other correction",c.CorrectionOther)}){<dt>@pair.Item1</dt><dd>@pair.Item2</dd>}</dl><h3>Immediate correction evidence</h3>@await Html.PartialAsync("_PrintActions",c.ImmediateActions)
<h2>Part B Complaint Processing</h2><dl class="report-dl">@foreach(var pair in new[]{("Responsible department",c.Department),("Received date",c.ReceivedDate?.ToString("dd MMM yyyy")??""),("Received by / via",c.ReceivedBy+" / "+c.ReceivedVia),("Complaint category",c.Category),("Seriousness / hazard / urgency",c.Seriousness+" / "+c.Hazard+" / "+c.Urgency),("Health hazard",c.HealthHazard?.ToString()??"N.A."),("Manufacturer claim",c.ManufacturerClaim?.ToString()??"N.A."),("Legislative requirement",c.LegislativeRequirement?.ToString()??"N.A."),("Intended purpose",c.IntendedPurpose?.ToString()??"N.A."),("Reporting review",c.ReportingReviewed?(c.Reportable?.ToString()??"Not applicable"):"Not yet reviewed"),("Reporting due date",c.ReportingDueDate?.ToString("dd MMM yyyy")??""),("Reporting basis",c.ReportingNote),("Root cause",c.RootCause),("Investigation by / date",c.Investigator+" / "+c.InvestigationDate?.ToString("dd MMM yyyy")),("Complaint owner",Person(c.OwnerId)),("HOD / QM / CM",Person(c.HodId)+" / "+Person(c.QmId)+" / "+Person(c.CmId)),("Response delay reason",c.ResponseDelayReason),("Response delay approval",c.ResponseDelayPending?"Pending":c.ResponseDelayApproved?"Approved":"Not approved"),("Extension reason",c.ExtensionReason),("Requested extension date",c.RequestedDueDate?.ToString("dd MMM yyyy")??""),("Extension status",c.ExtensionPending?"Pending · see decision history":"See decision history"),("Current due date",Ui.Date(c.DueAt))}){<dt>@pair.Item1</dt><dd>@pair.Item2</dd>}</dl><h3>Action plan and completion</h3>@await Html.PartialAsync("_PrintActions",c.Actions)
<h2>Part C Effectiveness and Closure</h2>@await Html.PartialAsync("_PrintActions",c.Effectiveness)<h3>Approval and activity history</h3><table class="print-table"><thead><tr><th>Date / time MYT</th><th>Actor / role</th><th>Decision or activity</th><th>Notes</th></tr></thead><tbody>@foreach(var entry in c.History){<tr><td>@Ui.Date(entry.At)</td><td>@entry.ActorName / @entry.ActorRole</td><td>@entry.Action</td><td>@entry.Note</td></tr>}</tbody></table><h3>Attached evidence</h3><ul>@foreach(var a in c.Attachments){<li>@a.Name · @a.Size bytes · @Ui.Date(a.UploadedAt)</li>}</ul><p class="small-text">Approvals identify the authenticated account, decision, and timestamp. Printed @Ui.Date(DateTimeOffset.UtcNow).</p><script src="/js/app.js"></script></body></html>
