@model (FormField Field,string Index)
<tr data-design-row><td><input type="hidden" name="Fields[@Model.Index].Key" value="@Model.Field.Key" /><input name="Fields[@Model.Index].Label" value="@Model.Field.Label" maxlength="150" required aria-label="Field label" /><input name="Fields[@Model.Index].Section" value="@Model.Field.Section" maxlength="150" aria-label="Field section" /><details><summary>Source evidence</summary><p>@Model.Field.Evidence</p></details></td><td><select name="Fields[@Model.Index].Type" aria-label="Field type">@foreach(var type in FormRuntime.Types){<option selected="@(Model.Field.Type==type)">@type</option>}</select><label class="studio-check"><input type="checkbox" name="Fields[@Model.Index].Required" value="true" checked="@Model.Field.Required" />Required</label></td><td><input name="Fields[@Model.Index].Stage" value="@Model.Field.Stage" type="number" min="0" max="20" aria-label="Field editing step" /></td><td><textarea name="Fields[@Model.Index].Options" rows="2" aria-label="Choice options" placeholder="Choices separated by |">@Model.Field.Options</textarea><textarea name="Fields[@Model.Index].Columns" rows="3" aria-label="Repeating table columns" placeholder="Table: one Label|text, Label|date or Label|number per line">@Model.Field.Columns</textarea></td><td><button type="button" class="text-button" data-remove-design-row>Remove field</button></td></tr>
