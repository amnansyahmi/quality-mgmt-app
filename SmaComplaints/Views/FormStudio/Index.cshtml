@model StudioVm
@{ViewData["Title"]="Form Studio";}
<div class="queue-page studio-page"><div class="queue-page-heading"><div><h1>Form Studio</h1><p>Import a form, review its fields and workflow, then publish a record workspace.</p></div><a class="btn secondary" href="/Forms">Form Library</a></div>@if(Model.Error is not null){<div class="alert error" role="alert">@Model.Error</div>}
<section class="queue-sheet studio-import"><h2>Upload a source form</h2><p>DOCX and text PDFs are read directly. Scanned PDFs, PNG and JPG files use local English OCR. Up to 20 MB and 20 PDF pages.</p><form action="/FormStudio/Import" method="post" enctype="multipart/form-data" data-busy-label="Extracting document…">@Html.AntiForgeryToken()<label for="source-form">Source document</label><input id="source-form" name="source" type="file" required accept=".docx,.pdf,.png,.jpg,.jpeg" /><button class="btn primary">Import & prepare draft</button></form><p class="studio-help">A draft is never published automatically. Review OCR text, table columns, required fields, permissions and the proposed sequence. Handwriting and complex conditional rules need additional review or implementation.</p></section>
<section class="queue-sheet"><header><h2>Imported forms <span>@Model.Forms.Count</span></h2></header>@if(Model.Forms.Count==0){<div class="queue-empty"><h2>No imported forms yet</h2><p>Start with a blank source template. The review screen lets you correct the extracted attributes before anyone uses the form.</p></div>}else{<div class="queue-table-scroll"><table class="queue-table"><thead><tr><th>Form / source</th><th>Status</th><th>Fields</th><th>Steps</th><th>Open</th></tr></thead><tbody>@foreach(var form in Model.Forms){<tr><td><a class="queue-reference" href="/FormStudio/Edit/@form.Id">@form.Name</a><small>@form.SourceName</small></td><td>@form.State</td><td>@form.FieldCount</td><td>@form.StepCount</td><td><a class="btn secondary small" href="/FormStudio/Edit/@form.Id">@(form.State=="Published"?"View design":"Review draft")</a></td></tr>}</tbody></table></div>}</section></div>
