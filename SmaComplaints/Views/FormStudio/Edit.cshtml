@model StudioVm
@{var d=Model.Definition;var locked=d.State=="Published";ViewData["Title"]=d.Name+" · Form Studio";}
<div class="queue-page studio-page"><div class="queue-page-heading"><div><h1>@(locked?"Published form design":"Review imported form")</h1><p>@d.SourceName · @d.ExtractionMethod · @d.Fields.Count proposed fields · @d.Steps.Count proposed steps</p></div><div class="studio-actions"><a class="btn secondary" href="/FormStudio">All imports</a><a class="btn secondary" href="/FormStudio/Preview/@d.Id">Preview saved form</a>@if(locked){<a class="btn primary" href="/Forms/Module/@d.Id">Open module</a>}</div></div>@if(Model.Error is not null){<div class="alert error" role="alert">@Model.Error</div>}
<details class="studio-source"><summary>Compare extracted text, source and import warnings (@d.Warnings.Count)</summary><a class="text-link" href="/FormStudio/Source/@d.Id">Download original source</a><ul>@foreach(var warning in d.Warnings){<li>@warning</li>}</ul><pre>@d.SourceText</pre><p>Extraction: @d.ExtractionMethod · SHA-256 @d.SourceDigest</p></details>
@if(locked){<p class="read-only-note">Published by @d.PublishedByName on @Ui.Date(d.PublishedAt). This definition is locked. Existing records keep a snapshot of their fields and workflow. Upload a new source as a separate module to avoid changing records already in progress.</p>}
<form action="/FormStudio/Save" method="post" class="studio-designer">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@d.Id" /><input type="hidden" name="revision" value="@d.Revision" /><fieldset disabled="@locked"><section class="queue-sheet studio-settings"><h2>Module name & submission permissions</h2><label for="module-name">Menu / form name</label><input id="module-name" name="Name" value="@d.Name" required maxlength="150" /><p>Publishing adds this name under Form Library in the navigation.</p><div class="studio-role-list">@foreach(var role in Roles.All){<label><input type="checkbox" name="SubmitRoles" value="@role" checked="@d.SubmitRoles.Contains(role)" />@role can submit</label>}</div></section>
<section class="queue-sheet"><header><h2>Fields & repeating tables</h2><button class="btn secondary small" type="button" data-add-design="fields">Add field</button></header><p class="studio-instruction">Step 0 is the submitter. A field assigned to step 1 or later becomes editable by that task holder. Choices use | separators. Table columns use one Label|text, Label|date or Label|number per line.</p><div class="queue-table-scroll"><table class="studio-design-table" data-design="fields"><thead><tr><th>Label / section</th><th>Type / required</th><th>Edit at step</th><th>Choices / table columns</th><th></th></tr></thead><tbody>@for(var i=0;i<d.Fields.Count;i++){@await Html.PartialAsync("_FieldRow",(d.Fields[i],i.ToString()))}</tbody></table></div></section>
<section class="queue-sheet"><header><h2>Workflow sequence</h2><button class="btn secondary small" type="button" data-add-design="steps">Add workflow step</button></header><p class="studio-instruction">This version runs sequential workflows. Conditional branches and calculated rules are not created automatically. Read the source before confirming this sequence. Add Form tasks for people who must fill later sections and Approval tasks for decisions. Allowed returns are earlier step numbers (for example 0,1); 0 returns to the submitter. No steps means submit and complete without approval.</p><div class="queue-table-scroll"><table class="studio-design-table" data-design="steps"><thead><tr><th>Step</th><th>Task name</th><th>Responsible role</th><th>Task type</th><th>Allowed returns</th><th></th></tr></thead><tbody>@for(var i=0;i<d.Steps.Count;i++){@await Html.PartialAsync("_StepRow",(d.Steps[i],i.ToString()))}</tbody></table></div></section>
@if(!locked){<div class="studio-publish"><label><input type="checkbox" name="reviewed" value="true" />I have checked the source, fields, table columns, editing stages, submitter permissions and approval/return sequence.</label><div><button class="btn secondary" name="command" value="save">Save design</button><button class="btn primary" name="command" value="publish">Publish module & menu</button></div></div>}</fieldset></form>
<template id="fields-template">@await Html.PartialAsync("_FieldRow",(new FormField{Key=""},"__INDEX__"))</template><template id="steps-template">@await Html.PartialAsync("_StepRow",(new FormStep(),"__INDEX__"))</template></div>
@section Scripts{<script src="~/js/form-studio.js" asp-append-version="true"></script>}
