@model (FormStep Step,string Index)
<tr data-design-row><td data-step-number></td><td><input name="Steps[@Model.Index].Name" value="@Model.Step.Name" maxlength="150" required aria-label="Step name" /><details><summary>Source evidence</summary><p>@Model.Step.Evidence</p></details></td><td><select name="Steps[@Model.Index].Role" aria-label="Step role">@foreach(var role in Roles.All){<option selected="@(role==Model.Step.Role)">@role</option>}</select></td><td><select name="Steps[@Model.Index].Kind" aria-label="Task type"><option selected="@(Model.Step.Kind=="Approval")">Approval</option><option selected="@(Model.Step.Kind=="Form")">Form</option></select></td><td><input name="Steps[@Model.Index].ReturnTo" value="@Model.Step.ReturnTo" aria-label="Allowed return step numbers" placeholder="0,1" /></td><td><button type="button" class="text-button" data-remove-design-row>Remove step</button></td></tr>
