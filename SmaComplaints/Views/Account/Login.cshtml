@model LoginVm
@inject IConfiguration Config
@{ViewData["Title"]="Sign in";var demo=Config.GetValue<bool>("DemoMode");}
<section class="login-story"><a class="brand" href="/"><span class="brandmark">S</span><span>SMA<span class="brand-sub">QUALITY MANAGEMENT</span></span></a><div><div class="eyebrow light">COMPLAINT MANAGEMENT</div><h1>A clear path from<br />concern to closure.</h1><p>Capture the details. Coordinate the response.<br />Keep every decision and its evidence together.</p><div class="login-steps"><span>01 <b>Notify</b></span><span>02 <b>Resolve</b></span><span>03 <b>Verify</b></span></div></div><small>SMA-FM-QM-05 · Revision 07</small></section>
<section class="login-form"><div class="login-form-inner"><div class="eyebrow">YOUR QUALITY WORKSPACE</div><h2>@(demo?"Explore the workflow":"Welcome back")</h2><p class="muted">@(demo?"Choose a role to try its inbox and assigned tasks.":"Sign in to view your complaints and assigned tasks.")</p>
@if(demo){<div class="role-grid">@foreach(var r in Roles.All){<form method="post" action="/Account/Demo">@Html.AntiForgeryToken()<input type="hidden" name="role" value="@r" /><button class="role-card"><span class="role-initial">@r[0]</span><strong>@r</strong><small>@(r switch{Roles.Requestor=>"Raise a complaint",Roles.Owner=>"Investigate & resolve",Roles.Hod=>"Review action plans",Roles.Qm=>"Evaluate & verify",Roles.Cm=>"Approve closure",_=>"Manage people & roles"})</small><span class="role-arrow">↗</span></button></form>}</div><p class="login-note">Development preview with synthetic records. These role shortcuts are disabled in production. Changes reset on restart.</p>}
else{<form asp-action="Login" method="post"><div asp-validation-summary="All" class="validation-summary"></div><input asp-for="ReturnUrl" type="hidden" /><div class="field"><label asp-for="Email">Work email</label><input asp-for="Email" autocomplete="username" /></div><div class="field"><label asp-for="Password">Password</label><input asp-for="Password" autocomplete="current-password" /></div><button class="btn primary full">Sign in</button></form><p class="login-note">Contact your administrator if you need an account or password reset.</p>}
</div></section>
