@model LoginVm
@inject IConfiguration Config
@{ViewData["Title"]="Sign in";var demo=Config.GetValue<bool>("DemoMode");}
<section class="login-story">
  <a class="brand" href="/"><span class="brand-name">SMA</span><span class="brand-sub">Quality management</span></a>
  <div class="login-story-body">
    <p class="eyebrow light">Complaint management</p>
    <h1>A clear path from concern to closure.</h1>
    <p class="login-lede">Capture the details, coordinate the response, and keep every decision with its evidence.</p>
    <ol class="login-steps"><li><span>01</span>Notify</li><li><span>02</span>Resolve</li><li><span>03</span>Verify</li></ol>
  </div>
  <small class="login-ref">SMA-FM-QM-05 · Revision 07</small>
</section>
<section class="login-form">
  <div class="login-form-inner">
    <p class="eyebrow">Your quality workspace</p>
    <h2>@(demo?"Explore the workflow":"Welcome back")</h2>
    <p class="muted">@(demo?"Choose a role to see its inbox and assigned tasks.":"Sign in to view your complaints and assigned tasks.")</p>
    @if(demo)
    {
      <ul class="role-list" aria-label="Preview roles">
      @foreach(var r in Roles.All)
      {
        <li><form method="post" action="/Account/Demo">@Html.AntiForgeryToken()<input type="hidden" name="role" value="@r" />
          <button class="role-option">
            <span class="role-icon"><icon name="@Icons.ForRole(r)" size="20" /></span>
            <span class="role-text"><strong>@r</strong><small>@(r switch{Roles.Requestor=>"Raise a complaint",Roles.Owner=>"Investigate and resolve",Roles.Hod=>"Review action plans",Roles.Qm=>"Evaluate and verify",Roles.Cm=>"Approve closure",_=>"Manage people and roles"})</small></span>
            <icon name="chevron-right" size="18" class="role-chevron" />
          </button>
        </form></li>
      }
      </ul>
      <p class="login-note"><icon name="info" size="16" /><span>Development preview with synthetic records. Role shortcuts are disabled in production, and changes reset on restart.</span></p>
    }
    else
    {
      <form asp-action="Login" method="post"><div asp-validation-summary="All" class="validation-summary"></div><input asp-for="ReturnUrl" type="hidden" /><div class="field"><label asp-for="Email">Work email</label><input asp-for="Email" autocomplete="username" /></div><div class="field"><label asp-for="Password">Password</label><input asp-for="Password" autocomplete="current-password" /></div><button class="btn primary full">Sign in</button></form>
      <p class="login-note">Contact your administrator if you need an account or password reset.</p>
    }
  </div>
</section>
