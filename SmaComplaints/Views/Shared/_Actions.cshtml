@model (string Prefix,List<ActionItem> Rows,bool Completion,bool Editable,bool FrozenPlan)
@{var canChangeRows=Model.Editable&&!Model.FrozenPlan;var count=canChangeRows?Math.Min(30,Math.Max(Model.Rows.Count+1,3)):Model.Rows.Count;}
<div class="action-rows" data-prefix="@Model.Prefix"><div class="table-scroll"><table class="form-table"><thead><tr><th>ACTION / CHECK</th><th>RESPONSIBLE</th><th>DUE DATE</th>@if(Model.Completion){<th>COMPLETED</th><th>OBJECTIVE EVIDENCE / DOCUMENT ID</th>}@if(canChangeRows){<th class="row-control"><span class="sr-only">Row actions</span></th>}</tr></thead><tbody>@for(var i=0;i<count;i++){var row=i<Model.Rows.Count?Model.Rows[i]:new ActionItem();<tr><td><input name="@(Model.Prefix)[@i].Description" value="@row.Description" aria-label="Action @(i+1) description" readonly="@Model.FrozenPlan" /></td><td><input name="@(Model.Prefix)[@i].Responsible" value="@row.Responsible" aria-label="Action @(i+1) responsible person" readonly="@Model.FrozenPlan" /></td><td><input type="date" name="@(Model.Prefix)[@i].DueDate" value="@row.DueDate?.ToString("yyyy-MM-dd")" aria-label="Action @(i+1) due date" readonly="@Model.FrozenPlan" /></td>@if(Model.Completion){<td><input type="date" name="@(Model.Prefix)[@i].CompletedDate" value="@row.CompletedDate?.ToString("yyyy-MM-dd")" max="@Ui.Today.ToString("yyyy-MM-dd")" aria-label="Action @(i+1) completion date" /></td><td><input name="@(Model.Prefix)[@i].Evidence" value="@row.Evidence" aria-label="Action @(i+1) evidence" /></td>}@if(canChangeRows){<td class="row-control"><button type="button" class="btn secondary small delete-action-row" aria-label="Delete action row @(i+1)">Delete row</button></td>}</tr>}</tbody></table></div>@if(canChangeRows){<button class="btn secondary small add-row" type="button"><icon name="plus" size="16" />Add another row</button>}</div>
