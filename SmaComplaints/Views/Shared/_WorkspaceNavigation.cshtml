@model (string Active,string Role,List<FormSummary> Forms)
@{
 var active=Model.Active;var role=Model.Role;
 var work=new[]{("overview","Overview","/","M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"),("inbox","My task inbox","/Complaints?view=inbox","M4 4h16v16H4zM4 14h5l2 3h2l2-3h5")};
}
<nav aria-label="Main navigation">
@foreach(var item in work){<a class="nav-item @(active==item.Item1?"active":"")" href="@item.Item3" aria-current="@(active==item.Item1?"page":null)" aria-label="@item.Item2" title="@item.Item2"><svg class="navicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="@item.Item4"/></svg><span class="nav-label">@item.Item2</span></a>}
<div class="nav-group-label">Complaints</div>
@if(role==Roles.Requestor){<form method="post" action="/Complaints/Create" class="nav-create">@Html.AntiForgeryToken()<button class="nav-item" aria-label="New complaint" title="New complaint"><svg class="navicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 4v16M4 12h16"/></svg><span class="nav-label">New complaint</span></button></form>}
<a class="nav-item @(active is "register" or "overdue"?"active":"")" href="/Complaints?view=register" aria-current="@(active is "register" or "overdue"?"page":null)" aria-label="Complaint register" title="Complaint register"><svg class="navicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 5h16M4 12h16M4 19h16"/></svg><span class="nav-label">Complaint register</span></a>
@if(role==Roles.Requestor){<a class="nav-item @(active=="drafts"?"active":"")" href="/Complaints?view=drafts" aria-current="@(active=="drafts"?"page":null)" aria-label="Drafts & resubmissions" title="Drafts & resubmissions"><svg class="navicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 3h16v18H4zM8 7h8M8 11h8M8 15h5"/></svg><span class="nav-label">Drafts & resubmissions</span></a>}
<div class="nav-group-label">Forms</div>
<a class="nav-item @(active=="forms"?"active":"")" href="/Forms" aria-current="@(active=="forms"?"page":null)" aria-label="Form Library" title="Form Library"><svg class="navicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 3h16v18H4zM8 7h8M8 11h8M8 15h5"/></svg><span class="nav-label">Form Library</span></a>
@foreach(var form in Model.Forms){<a class="nav-item module-nav @(active=="form-"+form.Id?"active":"")" href="/Forms/Module/@form.Id" aria-current="@(active=="form-"+form.Id?"page":null)" title="@form.Name" aria-label="@form.Name"><svg class="navicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M7 3h8l4 4v14H7zM10 12h6M10 16h6"/></svg><span class="nav-label">@form.Name</span></a>}
@if(role==Roles.Admin){<div class="nav-group-label">Administration</div><a class="nav-item @(active=="studio"?"active":"")" href="/FormStudio" aria-current="@(active=="studio"?"page":null)" aria-label="Form Studio" title="Form Studio"><svg class="navicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 4h16v16H4zM4 10h16M10 10v10"/></svg><span class="nav-label">Form Studio</span></a><a class="nav-item @(active=="admin"?"active":"")" href="/Admin" aria-current="@(active=="admin"?"page":null)" aria-label="People & roles" title="People & roles"><svg class="navicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg><span class="nav-label">People & roles</span></a>}
</nav>
