@model (string Active,string Role,List<FormSummary> Forms)
@{
 var active=Model.Active;var role=Model.Role;
 var work=new[]{("overview","Overview","/","overview"),("inbox","My task inbox","/Complaints?view=inbox","inbox")};
}
<nav class="sidebar-nav" aria-label="Main navigation">
<div class="nav-group-label">Workspace</div>
@foreach(var item in work){<a class="nav-item @(active==item.Item1?"active":"")" href="@item.Item3" aria-current="@(active==item.Item1?"page":null)" title="@item.Item2"><icon name="@item.Item4" class="navicon" /><span class="nav-label">@item.Item2</span></a>}
<div class="nav-group-label">Complaints</div>
@if(role==Roles.Requestor){<form method="post" action="/Complaints/Create" class="nav-create">@Html.AntiForgeryToken()<button class="nav-item" title="New complaint"><icon name="plus" class="navicon" /><span class="nav-label">New complaint</span></button></form>}
<a class="nav-item @(active is "register" or "overdue"?"active":"")" href="/Complaints?view=register" aria-current="@(active is "register" or "overdue"?"page":null)" title="Complaint register"><icon name="register" class="navicon" /><span class="nav-label">Complaint register</span></a>
@if(role==Roles.Requestor){<a class="nav-item @(active=="drafts"?"active":"")" href="/Complaints?view=drafts" aria-current="@(active=="drafts"?"page":null)" title="Drafts & resubmissions"><icon name="drafts" class="navicon" /><span class="nav-label">Drafts & resubmissions</span></a>}
<div class="nav-group-label">Forms</div>
<a class="nav-item @(active=="forms"?"active":"")" href="/Forms" aria-current="@(active=="forms"?"page":null)" title="Form library"><icon name="forms" class="navicon" /><span class="nav-label">Form library</span></a>
@foreach(var form in Model.Forms){<a class="nav-item module-nav @(active=="form-"+form.Id?"active":"")" href="/Forms/Module/@form.Id" aria-current="@(active=="form-"+form.Id?"page":null)" title="@form.Name"><icon name="form-module" class="navicon" /><span class="nav-label">@form.Name</span></a>}
@if(role==Roles.Admin){<div class="nav-group-label">Administration</div><a class="nav-item @(active=="studio"?"active":"")" href="/FormStudio" aria-current="@(active=="studio"?"page":null)" title="Form Studio"><icon name="studio" class="navicon" /><span class="nav-label">Form Studio</span></a><a class="nav-item @(active=="admin"?"active":"")" href="/Admin" aria-current="@(active=="admin"?"page":null)" title="People & roles"><icon name="people" class="navicon" /><span class="nav-label">People & roles</span></a>}
</nav>
