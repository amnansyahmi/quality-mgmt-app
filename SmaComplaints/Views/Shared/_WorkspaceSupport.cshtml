@model string
@{
 var guides=new[]{
 (Roles.Requestor,"Raise and correct complaints","Create a complaint, save Part A as a draft, add immediate actions and upload supporting evidence. Submit to the QM evaluation queue. If returned, correct and resubmit the same reference.","You can review your submitted complaints. Investigation and approval belong to the assigned roles."),
 (Roles.Owner,"Investigate and carry out actions","For assigned complaints, complete Part B evaluation, root cause and action plan. Save reporting answers for QM review. Submit the plan for HOD then QM approval. Complete the approved actions and add dates and evidence. Request a delay or extension from HOD when needed.","You can correct returned work. Approved action-plan descriptions, owners and dates stay locked during completion."),
 (Roles.Hod,"Review department work","Review assigned action plans and completed actions. Approve and forward to a named QM, or return to the owner with a reason. Decide response-delay and extension requests.","You can only decide tasks assigned to you. Required QM review cannot be skipped."),
 (Roles.Qm,"Evaluate, verify and review closure","Evaluate submitted complaints and assign the department, Owner, HOD, QM and CM. Confirm reportability after the owner saves the evaluation. Review action plans and completion after HOD, record effectiveness checks, and review closure before CM.","Only the assigned QM makes record-specific decisions. Unassigned evaluation tasks are shared by the active QM queue."),
 (Roles.Cm,"Approve final closure","Review the assigned closure package, effectiveness evidence and QM review. Approve and close, or return to QM review or effectiveness correction with a reason.","Final closure follows QM review. Closed records are read only."),
 (Roles.Admin,"Manage the workspace","Create and maintain people, active accounts and roles. Import source forms in Form Studio, review fields, submitter permissions, workflow stages and return destinations, then publish a module.","Administrator access lets you inspect records; it does not bypass task ownership or sign approvals for another role.")};
}
<dialog id="role-help" class="workspace-dialog" aria-labelledby="role-help-title"><header><div><small>WORKSPACE GUIDE</small><h2 id="role-help-title">Roles & workflow help</h2></div><button type="button" class="btn secondary small" data-close-dialog>Close</button></header><div class="dialog-content"><label for="help-role">Show responsibilities for</label><select id="help-role">@foreach(var guide in guides){<option selected="@(guide.Item1==Model)">@guide.Item1</option>}</select>
@foreach(var guide in guides){<article class="role-guide" data-role-guide="@guide.Item1" hidden="@(guide.Item1!=Model)"><p class="role-guide-label">@guide.Item1 @(guide.Item1==Model?"· your current role":"")</p><h3>@guide.Item2</h3><p>@guide.Item3</p><p class="role-limit">@guide.Item4</p></article>}
<section class="help-flow"><h3>Complaint sequence</h3><ol><li><b>Requestor</b> · notification and evidence</li><li><b>QM</b> · evaluation and assignment</li><li><b>Owner + QM</b> · investigation, action plan and reporting review</li><li><b>HOD → QM</b> · approve plan</li><li><b>Owner</b> · complete approved actions</li><li><b>HOD → QM</b> · review completed actions</li><li><b>QM → CM</b> · effectiveness, closure review and final closure</li></ol><p>Returning keeps the reference and history. The recipient corrects the work and repeats the required reviews.</p></section>
<section><h3>Where to go</h3><p><b>My task inbox</b> is the place to act on assigned complaints and Form Library records. <b>Complaint register</b> is for searching and reviewing complaints; its Due & overdue view highlights deadlines. <b>Drafts & resubmissions</b> contains the Requestor’s unfinished notifications. <b>Overview</b> shows complaint analytics.</p><p><b>Form Library</b> contains published modules. A module’s configured submitter roles and named task holders control its workflow; these can differ from the complaint process above.</p></section>
<section><h3>Notifications</h3><p>In-app notifications arrive when a task is passed or returned to you, an exception needs a decision, or a record is completed. Open a notification to mark it read and review the record. Marking it read does not complete the task. Older notifications may point to a task that has already moved on.</p><p>The bell refreshes every 30 seconds while this workspace is open. Complaint email delivery requires a configured SMTP relay; Form Library notifications are currently in-app.</p></section></div></dialog>
<dialog id="workspace-notifications" class="workspace-dialog notification-dialog" aria-labelledby="notification-title"><header><div><small>YOUR WORKSPACE</small><h2 id="notification-title">Notifications</h2></div><button type="button" class="btn secondary small" data-close-dialog>Close</button></header><div class="notification-tools"><span id="notification-summary" aria-live="polite">Loading notifications…</span><button class="btn secondary small" type="button" id="notification-read-all" disabled>Mark all read</button></div><p id="notification-error" class="notification-error" role="status" hidden></p><div id="notification-list" class="notification-list"></div><p id="notification-empty" class="notification-empty" hidden>No workflow notifications yet. Assigned work is always available in your task inbox.</p><footer><a class="btn primary small" href="/Complaints?view=inbox">Open my task inbox</a><small>Latest 50 · unread first. Read status does not change your tasks.</small></footer></dialog>
<template id="notification-template"><article class="notification-item"><div><strong data-notification-title></strong><p data-notification-body></p><time></time><span class="notification-read-label"></span></div><div class="notification-actions"><form action="/Notifications/Open" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" /><button class="btn primary small">Open record</button></form><button class="btn secondary small" type="button" data-notification-read>Mark read</button></div></article></template>
<form id="notification-token" hidden>@Html.AntiForgeryToken()</form>
