@model UserEditVm
@{ViewData["Title"]=Model.Id.HasValue?"Edit user":"Add user";}
<a class="back-link" href="/Admin"><icon name="back" size="16" /><span>People & roles</span></a><div class="page-heading"><div><div class="eyebrow">ADMINISTRATION</div><h1>@ViewData["Title"]</h1><p>Permissions are enforced on the server for every form and decision.</p></div></div><section class="panel form-body narrow-panel"><form method="post" asp-action="Edit"><input type="hidden" asp-for="Id" /><div asp-validation-summary="All" class="validation-summary"></div><div class="field-grid"><div class="field"><label asp-for="Name">Full name</label><input asp-for="Name" /></div><div class="field"><label asp-for="Email">Work email</label><input asp-for="Email" /></div><div class="field"><label asp-for="Role">Role</label><select asp-for="Role">@foreach(var role in Roles.All){<option>@role</option>}</select></div><div class="field"><label asp-for="Department">Department</label><input asp-for="Department" /></div></div><div class="field"><label asp-for="Password">@(Model.Id.HasValue?"New password (leave blank to keep current)":"Password")</label><input asp-for="Password" autocomplete="new-password" /><small>At least 12 characters. No default production accounts are provided.</small></div><label class="check-option"><input asp-for="Active" /> Active account</label><div class="form-footer"><a class="btn secondary" href="/Admin">Cancel</a><button class="btn primary">Save account</button></div></form></section>
