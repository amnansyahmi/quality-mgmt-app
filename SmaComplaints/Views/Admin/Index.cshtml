@model List<AppUser>
@{ViewData["Title"]="People & roles";}
<div class="page-heading"><div><div class="eyebrow">ADMINISTRATION</div><h1>People & roles</h1><p>Control who can submit, investigate, review, and approve complaints.</p></div><a href="/Admin/Edit" class="btn primary">＋ Add user</a></div><section class="panel"><div class="table-scroll"><table class="register-table"><thead><tr><th>NAME / EMAIL</th><th>ROLE</th><th>DEPARTMENT</th><th>STATUS</th><th></th></tr></thead><tbody>@foreach(var user in Model){<tr><td><strong>@user.Name</strong><small>@user.Email</small></td><td><span class="badge progress">@user.Role</span></td><td>@user.Department</td><td>@(user.Active?"Active":"Inactive")</td><td><a class="text-link" href="/Admin/Edit/@user.Id">Edit →</a></td></tr>}</tbody></table></div></section>
