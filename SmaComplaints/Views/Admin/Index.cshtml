@model List<AppUser>
@{ViewData["Title"]="People & roles";}
<div class="page-heading"><div><div class="eyebrow">ADMINISTRATION</div><h1>People & roles</h1><p>Control who can submit, investigate, review, and approve complaints.</p></div><a href="/Admin/Edit" class="btn primary"><icon name="plus" size="16" />Add user</a></div><section class="panel"><div class="table-scroll"><table class="register-table people-table"><thead><tr><th>Name / email</th><th>Role</th><th>Department</th><th>Status</th><th><span class="sr-only">Edit</span></th></tr></thead><tbody>@foreach(var user in Model){<tr><td class="cell-main"><strong>@user.Name</strong><small>@user.Email</small></td><td class="cell-meta" data-label="Role"><span class="badge progress">@user.Role</span></td><td class="cell-meta" data-label="Department">@user.Department</td><td class="cell-meta" data-label="Status">@(user.Active?"Active":"Inactive")</td><td class="cell-edit"><a class="text-link" href="/Admin/Edit/@user.Id" aria-label="Edit @user.Name">Edit<icon name="chevron-right" size="16" /></a></td></tr>}</tbody></table></div></section>
