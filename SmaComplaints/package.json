    "build:icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/cli": "4.3.0",
    "lucide-static": "1.62.0",
    "tailwindcss": "4.3.0"
  },
  "dependencies": {
    "chart.js": "4.6.1"
  }
}
