@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IAsyncDisposable
<div class="wf-board" data-theme="@Theme" @ref="ChartRoot">
<div class="wf-heading flex flex-wrap items-center justify-between gap-3"><div><h1>Complaint operations</h1><p>Review the queue, coordinate the response, verify the outcome.</p></div><div class="flex items-center gap-2"><button class="wf-icon-button" @onclick="ToggleTheme" aria-label="Toggle dashboard colour theme"><ConsoleIcon Name="@(Theme=="light"?"moon":"sun")" /></button><button class="wf-button" @onclick="Refresh"><ConsoleIcon Name="refresh" />Refresh</button><a class="wf-button" href="/Complaints/Export"><ConsoleIcon Name="download" />Export</a>@if(Model.Role==Roles.Requestor){<form method="post" action="/Complaints/Create"><input type="hidden" name="__RequestVerificationToken" value="@Model.AntiforgeryToken" /><button class="wf-button wf-primary"><ConsoleIcon Name="plus" />New complaint</button></form>}</div></div>
<section class="wf-summary" aria-label="Operational summary">@foreach(var stat in Summary){<button @onclick="()=>SetQueue(stat.Queue)" class="wf-stat" aria-pressed="@(Queue==stat.Queue)"><span>@stat.Label</span><strong class="tabular-nums">@stat.Count</strong><small>@stat.Description</small></button>}</section>
<div class="wf-bento">
<section class="wf-panel wf-flow"><header><h2>Workflow stages</h2><span>@Model.Rows.Count records</span></header><div class="wf-chart-frame"><canvas data-chart="stage" role="img" aria-label="@StageChartDescription">@StageChartDescription</canvas></div><div class="wf-chart-actions" role="group" aria-label="Filter by workflow stage">@foreach(var group in StageGroups){<button @onclick="()=>SetStageGroup(group.Stages)" aria-pressed="@StageGroup.SequenceEqual(group.Stages)">@group.Name <b>@CountStages(group.Stages)</b></button>}</div></section>
<section class="wf-panel wf-health"><header><h2>Deadline health</h2><span>@OpenCount open</span></header><div class="wf-donut-layout"><div class="wf-donut-frame"><canvas data-chart="deadline" role="img" aria-label="@DeadlineDescription">@DeadlineDescription</canvas><div class="wf-donut-label"><strong>@OpenCount</strong><span>open</span></div></div><div class="wf-legend"><button @onclick="()=>SetQueue(OverdueQueue)"><i class="failed"></i><span>Overdue</span><b>@Model.Rows.Count(x=>x.Overdue)</b></button><button @onclick="ShowDueSoon"><i class="paused"></i><span>Due in 3 days</span><b>@SoonCount</b></button><div><i class="active"></i><span>Later / no deadline</span><b>@Math.Max(0,OpenCount-Model.Rows.Count(x=>x.Overdue)-SoonCount)</b></div></div></div></section>
<section class="wf-panel wf-aging"><header><h2>Complaint aging</h2><span>Since last update</span></header><div class="wf-chart-frame"><canvas data-chart="aging" role="img" aria-label="@AgingDescription">@AgingDescription</canvas></div><footer>Inactivity in open records</footer></section>
<section class="wf-panel wf-departments"><header><h2>Department workload</h2><span>Open records</span></header><div class="wf-chart-frame"><canvas data-chart="department" role="img" aria-label="@DepartmentDescription">@DepartmentDescription</canvas></div>@if(!Departments.Any()){<p class="wf-empty">No open department assignments.</p>}</section>
<section class="wf-panel wf-intake"><header><h2>Daily intake</h2><span>@Intake.Sum(x=>x.Count) created · last 7 days</span></header><div class="wf-chart-frame"><canvas data-chart="intake" role="img" aria-label="@IntakeDescription">@IntakeDescription</canvas></div></section>
<section class="wf-panel wf-queue"><header><div><h2>Work queue <span class="wf-count">@VisibleRows.Count</span></h2></div><span>@(StageGroup.Length>0?"Stage group filter applied":"Authorized records")</span></header><div class="wf-filters"><div class="wf-filter-tabs" role="group" aria-label="Queue filters">@foreach(var filter in Filters){<button class="@(Queue==filter.Queue?"selected":"")" @onclick="()=>SetQueue(filter.Queue)" aria-pressed="@(Queue==filter.Queue)">@filter.Label <span>@QueueCount(filter.Queue)</span></button>}</div><div class="wf-search-row"><label class="wf-search"><ConsoleIcon Name="search" /><span class="sr-only">Search records</span><input value="@Search" @oninput="SearchChanged" placeholder="Reference, customer, subject…" /></label><label><span class="sr-only">Sort records</span><select value="@Sort" @onchange="SortChanged"><option value="updated">Latest updated</option><option value="due">Earliest deadline</option><option value="reference">Reference</option></select></label><button class="wf-icon-button" @onclick="ClearFilters" aria-label="Clear queue filters"><ConsoleIcon Name="refresh" /></button></div></div>
<div class="wf-table-scroll" tabindex="0" aria-label="Complaint records table"><table class="wf-table"><caption class="sr-only">Complaint work queue. Use a reference to open the record or Inspect to view its summary.</caption><thead><tr><th>Complaint</th><th>Customer / laboratory</th><th>Workflow stage</th><th>Assigned to</th><th>Deadline</th><th><span class="sr-only">Inspect</span></th></tr></thead><tbody>@foreach(var row in VisibleRows.Take(100)){<tr class="@(Selected?.Id==row.Id?"is-selected":"")" @key="row.Id"><td><a href="/Complaints/Details/@row.Id" class="wf-ref">@row.Reference</a><span class="wf-subject" title="@row.Subject">@row.Subject</span></td><td><span class="wf-customer">@row.Customer</span><small>@row.Hospital</small></td><td><span class="wf-stage-badge @StageClass(row.Stage)"><ConsoleIcon Name="@StageIcon(row.Stage)" />@Ui.StageName(row.Stage)</span>@if(row.ExtensionPending){<small class="wf-waiting">Exception request pending</small>}</td><td><span>@row.Owner</span><small>@row.TaskRole</small></td><td><span class="@(row.Overdue?"wf-overdue":"")">@ShortDate(row.DueAt)</span><small>@(row.Overdue?"Overdue":row.DueAt.HasValue?"MYT":"No active deadline")</small></td><td><button class="wf-icon-button" @onclick="()=>Select(row.Id)" aria-label="Inspect @row.Reference" aria-pressed="@(Selected?.Id==row.Id)"><ConsoleIcon Name="eye" /></button></td></tr>}</tbody></table></div>@if(VisibleRows.Count==0){<div class="wf-empty"><ConsoleIcon Name="search" /><h3>No matching records</h3><p>Clear the filters or choose another queue.</p><button class="wf-button" @onclick="ClearFilters">Clear filters</button></div>}<footer><span role="status" aria-live="polite">@VisibleRows.Count matching records; showing @Math.Min(100,VisibleRows.Count).</span><span>Live role permissions</span></footer></section>
<aside class="wf-side-stack"><section class="wf-panel wf-inspector"><header><h2>Record inspector</h2><ConsoleIcon Name="eye" /></header>@if(Selected is WorkflowRow selected){<div class="wf-inspector-body"><a class="wf-ref" href="/Complaints/Details/@selected.Id">@selected.Reference</a><h3>@selected.Subject</h3><span class="wf-stage-badge @StageClass(selected.Stage)"><ConsoleIcon Name="@StageIcon(selected.Stage)" />@Ui.StageName(selected.Stage)</span><dl><dt>Responsible person</dt><dd>@selected.Owner <small>@selected.TaskRole</small></dd><dt>Department</dt><dd>@(selected.Department==""?"Awaiting assignment":selected.Department)</dd><dt>Current deadline</dt><dd class="@(selected.Overdue?"wf-overdue":"")">@Ui.Date(selected.DueAt)</dd><dt>Last update</dt><dd>@Ui.Date(selected.UpdatedAt)</dd></dl>@if(selected.ReportingPending){<div class="wf-inline-warning"><ConsoleIcon Name="alert" />QM reporting review required</div>}@if(selected.ExtensionPending){<div class="wf-inline-warning"><ConsoleIcon Name="pause" />An exception request needs HOD review.</div>}<div class="wf-next-step"><span>Next step</span><strong>@Workflow.AdvanceLabel(selected.Stage)</strong></div><a class="wf-button wf-primary wf-full" href="/Complaints/Details/@selected.Id?tab=@TaskTab(selected.Stage)">Open current task<ConsoleIcon Name="arrow" /></a></div>}else{<p class="wf-empty">Choose a complaint to inspect its current task.</p>}</section>
<section class="wf-panel wf-state-reference"><header><h2>Pipeline state reference</h2><button class="wf-icon-button" @onclick="ToggleStates" aria-expanded="@ShowStates" aria-label="Toggle pipeline state reference"><ConsoleIcon Name="list" /></button></header>@if(ShowStates){<div class="wf-state-list">@foreach(var state in new[]{("Active","play","Processing can proceed"),("Paused","pause","Explicit hold or dependency"),("Failed","alert","Execution ended with an error")}){<div class="wf-state-example @state.Item1.ToLowerInvariant()"><span><ConsoleIcon Name="@state.Item2" /><b>@state.Item1</b></span><small>@state.Item3</small></div>}</div><footer>Design reference. Runtime states are separate from complaint stages and overdue deadlines.</footer>}</section></aside>
<section class="wf-panel wf-activity"><header><h2>Recent activity</h2><span>Latest record updates</span></header><div class="wf-recent-grid">@foreach(var row in Model.Rows.OrderByDescending(x=>x.UpdatedAt).Take(4)){<a href="/Complaints/Details/@row.Id?tab=history"><span class="wf-activity-icon"><ConsoleIcon Name="@StageIcon(row.Stage)" /></span><div><strong>@row.Reference</strong><span>@Ui.StageName(row.Stage)</span><small>@Ui.Date(row.UpdatedAt)</small></div><ConsoleIcon Name="arrow" /></a>}</div></section>
</div><div id="blazor-error-ui">The dashboard connection was interrupted. <a href="/">Reload to reconnect</a>.</div>
</div>
@code {
    ElementReference ChartRoot;
    Microsoft.JSInterop.IJSObjectReference? ChartModule;
    Microsoft.JSInterop.DotNetObjectReference<WorkflowDashboard>? ChartCallback;
    string? RenderedTheme;
    string AgingDescription=>string.Join(", ",AgingBuckets.Select(x=>$"{x.Label}: {x.Count}"));
    string DepartmentDescription=>string.Join(", ",Departments.Select(x=>$"{x.Name}: {x.Count}"));
    object ChartData=>new {stage=new{labels=StageGroups.Select(x=>x.Name),values=StageGroups.Select(x=>CountStages(x.Stages))},deadline=new{labels=new[]{"Overdue","Due in 3 days","Later / no deadline"},values=new[]{Model.Rows.Count(x=>x.Overdue),SoonCount,Math.Max(0,OpenCount-Model.Rows.Count(x=>x.Overdue)-SoonCount)}},aging=new{labels=AgingBuckets.Select(x=>x.Label),values=AgingBuckets.Select(x=>x.Count)},department=new{labels=Departments.Select(x=>x.Name),values=Departments.Select(x=>x.Count)},intake=new{labels=Intake.Select(x=>x.Date.ToString("dd MMM")),values=Intake.Select(x=>x.Count)}};
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender){ChartModule=await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import","/js/workflow-charts.js");ChartCallback=Microsoft.JSInterop.DotNetObjectReference.Create(this);await ChartModule.InvokeVoidAsync("mount",ChartRoot,ChartData,ChartCallback);RenderedTheme=Theme;}
        else if(ChartModule is not null && RenderedTheme!=Theme){await ChartModule.InvokeVoidAsync("refresh",ChartRoot,ChartData);RenderedTheme=Theme;}
    }
    [Microsoft.JSInterop.JSInvokable]public Task FilterChart(string chart,int index){if(chart=="stage" && index>=0 && index<StageGroups.Length)SetStageGroup(StageGroups[index].Stages);else if(chart=="deadline" && index==0)SetQueue(OverdueQueue);else if(chart=="deadline" && index==1)ShowDueSoon();return InvokeAsync(StateHasChanged);}
    public async ValueTask DisposeAsync(){if(ChartModule is not null){try{await ChartModule.InvokeVoidAsync("destroy",ChartRoot);await ChartModule.DisposeAsync();}catch(Microsoft.JSInterop.JSDisconnectedException){}}ChartCallback?.Dispose();}
    [Parameter]public WorkflowBoardModel Model{get;set;}=new();
    string Theme="light",Queue="all",Search="",Sort="updated";bool ShowStates=false,DueSoonOnly;Guid? SelectedId;Stage[] StageGroup=[];const string OverdueQueue="overdue";
    protected override void OnInitialized(){Search=Model.Query;Queue=Model.InitialView switch{"inbox"=>"mine","overdue"=>"overdue","drafts"=>"drafts",_=>"all"};if(Enum.TryParse<Stage>(Model.StageFilter,out var stage))StageGroup=[stage];}
    bool IsOpen(WorkflowRow r)=>r.Stage is not(Stage.Draft or Stage.Closed);
    int OpenCount=>Model.Rows.Count(IsOpen);
    bool IsSoon(WorkflowRow x)=>IsOpen(x)&&!x.Overdue&&x.DueAt<=DateTimeOffset.UtcNow.AddDays(3);
    int SoonCount=>Model.Rows.Count(IsSoon);
    (DateOnly Date,int Count)[] Intake=>Enumerable.Range(0,7).Select(i=>Ui.Today.AddDays(i-6)).Select(day=>(Date:day,Count:Model.Rows.Count(row=>DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(row.CreatedAt,Ui.Zone).DateTime)==day))).ToArray();

    string IntakeDescription=>string.Join(", ",Intake.Select(x=>$"{x.Date:dd MMM}: {x.Count} complaints created"));
    int Percent(int value,int total)=>total==0?0:(int)Math.Round(100d*value/total);
    int OverduePercent=>Percent(Model.Rows.Count(x=>x.Overdue),OpenCount);
    int SoonPercent=>Percent(SoonCount,OpenCount);
    string DeadlineDescription=>$"{Model.Rows.Count(x=>x.Overdue)} overdue, {SoonCount} due in three days, {Math.Max(0,OpenCount-Model.Rows.Count(x=>x.Overdue)-SoonCount)} later or without a deadline.";
    bool QueueMatch(WorkflowRow x,string queue)=>queue switch{"mine"=>x.Mine,"overdue"=>x.Overdue,"approval"=>x.Approval,"closed"=>x.Stage==Stage.Closed,"drafts"=>x.Stage==Stage.Draft,_=>true};
    int QueueCount(string queue)=>Model.Rows.Count(x=>QueueMatch(x,queue));
    List<WorkflowRow> VisibleRows{get{var rows=Model.Rows.Where(x=>QueueMatch(x,Queue)).Where(x=>StageGroup.Length==0||StageGroup.Contains(x.Stage)).Where(x=>!DueSoonOnly||IsSoon(x)).Where(x=>string.IsNullOrWhiteSpace(Search)||$"{x.Reference} {x.Subject} {x.Customer} {x.Hospital}".Contains(Search,StringComparison.OrdinalIgnoreCase));return (Sort switch{"due"=>rows.OrderBy(x=>x.DueAt??DateTimeOffset.MaxValue),"reference"=>rows.OrderBy(x=>x.Reference),_=>rows.OrderByDescending(x=>x.UpdatedAt)}).ToList();}}
    WorkflowRow? Selected=>VisibleRows.FirstOrDefault(x=>x.Id==SelectedId)??VisibleRows.FirstOrDefault(x=>x.Mine)??VisibleRows.FirstOrDefault();
    (string Label,int Count,string Description,string Queue)[] Summary=>[("Open",OpenCount,"In the response process","all"),("My tasks",Model.Rows.Count(x=>x.Mine),"Assigned to your account","mine"),("Overdue",Model.Rows.Count(x=>x.Overdue),"Needs deadline attention","overdue"),("Awaiting approval",Model.Rows.Count(x=>x.Approval),"HOD, QM, or CM decision","approval"),("Closed",Model.Rows.Count(x=>x.Stage==Stage.Closed),"Effectiveness reviewed","closed")];
    (string Label,string Queue)[] Filters=>[("All records","all"),("My tasks","mine"),("Overdue","overdue"),("Approvals","approval"),("Closed","closed")];
    (string Name,Stage[] Stages)[] StageGroups=>[("Notification",[Stage.Draft,Stage.Evaluation]),("Investigation",[Stage.Investigation]),("Approvals",[Stage.PlanHod,Stage.PlanQm,Stage.CompletionHod,Stage.CompletionQm,Stage.ClosureQm,Stage.ClosureCm]),("Actions",[Stage.Actions]),("Effectiveness",[Stage.Effectiveness]),("Closed",[Stage.Closed])];
    int CountStages(Stage[] stages)=>Model.Rows.Count(x=>stages.Contains(x.Stage));
    int BarHeight(Stage[] stages)=>Percent(CountStages(stages),Math.Max(1,StageGroups.Max(x=>CountStages(x.Stages))));
    string StageChartDescription=>string.Join(", ",StageGroups.Select(x=>$"{x.Name}: {CountStages(x.Stages)}"));
    (string Label,int Count)[] AgingBuckets=>[("0–2 days",Model.Rows.Count(x=>IsOpen(x)&&Age(x)<=2)),("3–7 days",Model.Rows.Count(x=>IsOpen(x)&&Age(x)>2&&Age(x)<=7)),("8–14 days",Model.Rows.Count(x=>IsOpen(x)&&Age(x)>7&&Age(x)<=14)),("15+ days",Model.Rows.Count(x=>IsOpen(x)&&Age(x)>14))];
    double Age(WorkflowRow x)=>Math.Max(0,(DateTimeOffset.UtcNow-x.UpdatedAt).TotalDays);
    IEnumerable<(string Name,int Count)> Departments=>Model.Rows.Where(IsOpen).GroupBy(x=>x.Department==""?"Awaiting assignment":x.Department).Select(g=>(Name:g.Key,Count:g.Count())).OrderByDescending(x=>x.Count).Take(5);
    void Select(Guid id)=>SelectedId=id;
    void SetQueue(string queue){Queue=queue;StageGroup=[];DueSoonOnly=false;}
    void ShowDueSoon(){Queue="all";StageGroup=[];DueSoonOnly=true;}
    void SetStageGroup(Stage[] stages){Queue="all";StageGroup=stages;DueSoonOnly=false;}
    void SearchChanged(ChangeEventArgs e)=>Search=e.Value?.ToString()??"";
    void SortChanged(ChangeEventArgs e)=>Sort=e.Value?.ToString()??"updated";
    void ClearFilters(){Queue="all";Search="";StageGroup=[];DueSoonOnly=false;}
    void ToggleTheme()=>Theme=Theme=="light"?"dark":"light";
    void ToggleStates()=>ShowStates=!ShowStates;
    void Refresh()=>Navigation.NavigateTo(Navigation.Uri,forceLoad:true);
    string ShortDate(DateTimeOffset? value)=>value.HasValue?TimeZoneInfo.ConvertTime(value.Value,Ui.Zone).ToString("dd MMM"):"—";
    string TaskTab(Stage stage)=>stage==Stage.Draft?"notification":stage is Stage.Effectiveness or Stage.ClosureQm or Stage.ClosureCm?"effectiveness":"processing";
    string StageClass(Stage stage)=>stage switch{Stage.Closed=>"completed",Stage.Draft=>"draft",Stage.PlanHod or Stage.PlanQm or Stage.CompletionHod or Stage.CompletionQm or Stage.ClosureQm or Stage.ClosureCm=>"approval",_=>"working"};
    string StageIcon(Stage stage)=>stage switch{Stage.Closed=>"check",Stage.Draft=>"list",Stage.PlanHod or Stage.PlanQm or Stage.CompletionHod or Stage.CompletionQm or Stage.ClosureQm or Stage.ClosureCm=>"clock",_=>"play"};
}
